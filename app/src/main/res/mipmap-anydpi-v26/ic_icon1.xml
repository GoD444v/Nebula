<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive (API 26+) version of icon 1. Launchers shrink plain legacy PNGs, which
     made the icon look small; as a background layer the art fills the full mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_icon1_art" />
    <foreground android:drawable="@drawable/ic_icon_foreground_clear" />
</adaptive-icon>
