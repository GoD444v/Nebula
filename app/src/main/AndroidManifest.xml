<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Downloads write to the app's own cache dir, so no storage permission is
         needed. Only the foreground dataSync service type is declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NebulaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_icon1"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nebula">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Nebula" />
        <!-- The LAUNCHER intent lives on the aliases, not on the activity: enabling one
             alias (Settings -> App icon) is what swaps the icon at runtime. Icon 1 is
             the default (enabled="true"); the other two start disabled. -->
        <activity-alias
            android:name=".LauncherIcon1"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_icon1"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon2"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIcon3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_icon3"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <service
            android:name=".player.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Offline downloads. Media3's DownloadService owns the foreground
             notification and JobScheduler rescheduling; no broadcast receiver is
             needed because its notification actions are service PendingIntents. -->
        <service
            android:name=".player.NebulaDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>